# Groq API — used by app/api/chat/route.ts
GROQ_API_KEY=your_groq_api_key_here

# Azure AD app registration — used by lib/graph.ts for Microsoft Graph API access
# Register an app at https://portal.azure.com under Azure Active Directory > App registrations
# Grant it these application permissions with admin consent:
#   Sites.Read.All      — required for status lookups (getCaseStatus)
#   Sites.ReadWrite.All  — required for case submission (createCase)
AZURE_CLIENT_ID=your_azure_app_client_id
AZURE_CLIENT_SECRET=your_azure_app_client_secret
AZURE_TENANT_ID=migrantdesk_tenant_id

# SharePoint site and list that stores case records
# Site ID: GET https://graph.microsoft.com/v1.0/sites/{hostname}:/sites/{site-path}
# List ID: GET https://graph.microsoft.com/v1.0/sites/{siteId}/lists
SHAREPOINT_SITE_ID=your_sharepoint_site_id
SHAREPOINT_LIST_ID=your_sharepoint_list_id
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Basic auth gate for /live-desk and the /api/conversations* routes
# (staff-only conversation log — see middleware.ts). Set these in Vercel
# too, or the route fails closed (401) with no credentials configured.
LIVE_DESK_USERNAME=your_live_desk_username
LIVE_DESK_PASSWORD=your_live_desk_password